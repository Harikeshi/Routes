create user viz_user password '1';
create database viz_log owner viz_user;

CREATE TABLE if not exists targets (
    id SERIAL PRIMARY KEY,
    x DOUBLE PRECISION NOT NULL,
    y DOUBLE PRECISION NOT NULL,
    root_mean_square_error DOUBLE PRECISION,
    left_course DOUBLE PRECISION,
    right_course DOUBLE PRECISION,
    current_velocity DOUBLE PRECISION,
    max_velocity DOUBLE PRECISION,
    min_noise_reduced DOUBLE PRECISION,
    max_noise_reduced DOUBLE PRECISION,
    obsolescence_time DOUBLE PRECISION,
    avoidance_distance DOUBLE PRECISION
);

INSERT INTO targets (
    x, y, root_mean_square_error,
    left_course, right_course,
    current_velocity, max_velocity,
    min_noise_reduced, max_noise_reduced,
    obsolescence_time, avoidance_distance
) VALUES (
    10.5, 20.3, 0.5,
    45.0, 315.0,
    5.2, 8.7,
    0.1, 0.9,
    30.0, 2.5
);

create table if not exists info(
    id SERIAL PRIMARY KEY,
    date TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    username VARCHAR(255) NOT NULL,
    message VARCHAR(255) NOT NULL,
    severity VARCHAR(20) CHECK (severity IN ('ERROR', 'INFO', 'WARNING', 'SUCCESS', 'CRITICAL'))
);

create table if not exists ship(
    id SERIAL PRIMARY KEY,
    count INTEGER NOT NULL,
    detection INTEGER NOT NULL
);

create table if NOT EXISTS requests(
    id SERIAL PRIMARY KEY,
    time BIGINT NOT NULL,
    target VARCHAR(255) NOT NULL,
    search_region VARCHAR(255) NOT NULL,
    border_line VARCHAR(255) NOT NULL,
    id_ship INTEGER REFERENCES ship(id)
);

create table if not exists events(
    id SERIAL PRIMARY KEY,
    date TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    username VARCHAR(255) NOT NULL,
    message TEXT,
    json_content JSONB, -- JSONB для бинарного хранения
    id_request INTEGER REFERENCES requests(id)
);

CREATE TABLE IF NOT EXISTS error_logs (
    id SERIAL PRIMARY KEY,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    message TEXT NOT NULL,
    stack_trace TEXT,
    source VARCHAR(255),
    severity VARCHAR(20) CHECK (severity IN ('DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'))
);

-- индексация
CREATE INDEX idx_events_date ON events(date);
CREATE INDEX idx_events_id_request ON events(id_request);
CREATE INDEX idx_requests_id_ship ON requests(id_ship);
