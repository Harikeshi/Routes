
```cpp
#include <iostream>
#include <pqxx/pqxx>

int main() {
    try {
        // Подключение к базе данных
        pqxx::connection conn("dbname=your_db user=your_user password=your_password hostaddr=127.0.0.1 port=5432");
        
        if (conn.is_open()) {
            std::cout << "Connected to database successfully!" << std::endl;
            
            // Начинаем транзакцию
            pqxx::work txn(conn);
            
            // 1. Вставляем основную запись в таблицу missions
            pqxx::result mission_res = txn.exec(
                "INSERT INTO missions (time) VALUES (50) RETURNING id;"
            );
            int mission_id = mission_res[0][0].as<int>();
            
            // 2. Вставляем параметры цели
            txn.exec_params(
                "INSERT INTO target_parameters ("
                "mission_id, detection_point, rmse, courses, "
                "current_velocity, max_velocity, min_noise_reduced_velocity, "
                "max_noise_reduced_velocity, obsolescence_time, avoidance_distance"
                ") VALUES ($1, point(0, 0), $2, $3, $4, $5, $6, $7, $8, $9)",
                mission_id,
                99999,
                pqxx::array<float>{360, 360},
                99.99,
                99.99,
                99.99,
                99.99,
                999999,
                999999
            );
            
            // 3. Вставляем область поиска
            pqxx::result region_res = txn.exec_params(
                "INSERT INTO search_regions (mission_id, entry_point, exit_point) "
                "VALUES ($1, point(0, 6), point(25, 6)) RETURNING id;",
                mission_id
            );
            int region_id = region_res[0][0].as<int>();
            
            // 4. Вставляем границы области поиска (полигоны)
            // Первый полигон
            txn.exec_params(
                "INSERT INTO region_borders (region_id, polygon) VALUES ("
                "$1, polygon '((0, 0), (0, 20), (20, 20), (20, 4), (25, 20), (25, 0))')",
                region_id
            );
            
            // Второй полигон (внутренний)
            txn.exec_params(
                "INSERT INTO region_borders (region_id, polygon) VALUES ("
                "$1, polygon '((7, 8), (7, 12), (13, 12), (13, 8))')",
                region_id
            );
            
            // 5. Вставляем граничную линию
            txn.exec_params(
                "INSERT INTO border_lines (mission_id, points) VALUES ("
                "$1, $2)",
                mission_id,
                pqxx::array<std::string>{"(0,0)", "(1,1)", "(2,2)"}
            );
            
            // 6. Вставляем параметры кораблей
            txn.exec_params(
                "INSERT INTO ship_parameters ("
                "mission_id, count, detection_range, max_velocity, "
                "search_velocity, turning_radius, min_length_section"
                ") VALUES ($1, $2, $3, $4, $5, $6, $7)",
                mission_id,
                99,
                3.0,
                18.0,
                12.0,
                3.0,
                2.0
            );
            
            // Коммитим транзакцию
            txn.commit();
            std::cout << "Data inserted successfully!" << std::endl;
        } else {
            std::cerr << "Failed to connect to database!" << std::endl;
            return 1;
        }
        
        conn.disconnect();
    } catch (const std::exception &e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }
    
    return 0;
}
```

## Альтернативный вариант с использованием JSONB

Если вы предпочитаете использовать JSONB-подход (как в первом примере SQL), вот более простой вариант:

```cpp
#include <iostream>
#include <pqxx/pqxx>
#include <nlohmann/json.hpp>

using json = nlohmann::json;

int main() {
    try {
        // Подключение к базе данных
        pqxx::connection conn("dbname=your_db user=your_user password=your_password hostaddr=127.0.0.1 port=5432");
        
        if (conn.is_open()) {
            std::cout << "Connected to database successfully!" << std::endl;
            
            // Создаем JSON объекты
            json form_target = {
                {"detection_point", {0, 0}},
                {"root-mean-square_error", 99999},
                {"courses", {360, 360}},
                {"velocities", {
                    {"current", 99.99},
                    {"max", 99.99},
                    {"min_noise-reduced", 99.99},
                    {"max_noise-reduced", 99.99}
                }},
                {"obsolescence_time", 999999},
                {"avoidance_distance", 999999}
            };
            
            json search_region = {
                {"borders", {
                    {{0, 0}, {0, 20}, {20, 20}, {20, 4}, {25, 20}, {25, 0}},
                    {{7, 8}, {7, 12}, {13, 12}, {13, 8}}
                }},
                {"entry_point", {0, 6}},
                {"exit_point", {25, 6}}
            };
            
            json border_line = {{0, 0}, {1, 1}, {2, 2}};
            
            json ships_parameters = {
                {"count", 99},
                {"detection_range", 3},
                {"max_velocity", 18},
                {"search_velocity", 12},
                {"turning_radius", 3},
                {"min_lenght_section", 2}
            };
            
            // Вставляем данные
            pqxx::work txn(conn);
            txn.exec_params(
                "INSERT INTO mission_data (time, form_target, search_region, border_line, ships_parameters) "
                "VALUES ($1, $2::jsonb, $3::jsonb, $4::jsonb, $5::jsonb)",
                50,
                form_target.dump(),
                search_region.dump(),
                border_line.dump(),
                ships_parameters.dump()
            );
            
            txn.commit();
            std::cout << "Data inserted successfully!" << std::endl;
        }
        
        conn.disconnect();
    } catch (const std::exception &e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }
    
    return 0;
}
```

## Примечания

1. Для JSONB-варианта вам понадобится библиотека nlohmann/json для работы с JSON в C++.
2. Убедитесь, что вы заменили параметры подключения (dbname, user, password) на свои.
3. В первом варианте я использовал PostgreSQL-специфичные типы данных (point, polygon), которые могут потребовать дополнительной обработки в вашем приложении.
4. Для компиляции вам нужно будет подключить библиотеки pqxx и nlohmann/json.