```sql
-- Создание таблицы
CREATE TABLE mission_data (
    id SERIAL PRIMARY KEY,
    time INTEGER,
    form_target JSONB,
    search_region JSONB,
    border_line JSONB,
    ships_parameters JSONB,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Вставка данных
INSERT INTO mission_data (time, form_target, search_region, border_line, ships_parameters)
VALUES (
    50,
    '{
        "detection_point": [0, 0],
        "root-mean-square_error": 99999,
        "courses": [360, 360],
        "velocities": {
            "current": 99.99,
            "max": 99.99,
            "min_noise-reduced": 99.99,
            "max_noise-reduced": 99.99
        },
        "obsolescence_time": 999999,
        "avoidance_distance": 999999
    }',
    '{
        "borders": [
            [[0, 0], [0, 20], [20, 20], [20, 4], [25, 20], [25, 0]],
            [[7, 8], [7, 12], [13, 12], [13, 8]]
        ],
        "entry_point": [0, 6],
        "exit_point": [25, 6]
    }',
    '[[0, 0], [1, 1], [2, 2]]',
    '{
        "count": 99,
        "detection_range": 3,
        "max_velocity": 18,
        "search_velocity": 12,
        "turning_radius": 3,
        "min_lenght_section": 2
    }'
);
```

## Альтернативный вариант с более структурированной таблицей

Если вы предпочитаете более нормализованную структуру, можно создать несколько связанных таблиц:

```sql
-- Основная таблица
CREATE TABLE missions (
    id SERIAL PRIMARY KEY,
    time INTEGER NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Параметры цели
CREATE TABLE target_parameters (
    id SERIAL PRIMARY KEY,
    mission_id INTEGER REFERENCES missions(id),
    detection_point POINT,
    rmse FLOAT,
    courses FLOAT[],
    current_velocity FLOAT,
    max_velocity FLOAT,
    min_noise_reduced_velocity FLOAT,
    max_noise_reduced_velocity FLOAT,
    obsolescence_time BIGINT,
    avoidance_distance BIGINT
);

-- Область поиска
CREATE TABLE search_regions (
    id SERIAL PRIMARY KEY,
    mission_id INTEGER REFERENCES missions(id),
    entry_point POINT,
    exit_point POINT
);

-- Границы области поиска
CREATE TABLE region_borders (
    id SERIAL PRIMARY KEY,
    region_id INTEGER REFERENCES search_regions(id),
    polygon POLYGON
);

-- Граничная линия
CREATE TABLE border_lines (
    id SERIAL PRIMARY KEY,
    mission_id INTEGER REFERENCES missions(id),
    points POINT[]
);

-- Параметры кораблей
CREATE TABLE ship_parameters (
    id SERIAL PRIMARY KEY,
    mission_id INTEGER REFERENCES missions(id),
    count INTEGER,
    detection_range FLOAT,
    max_velocity FLOAT,
    search_velocity FLOAT,
    turning_radius FLOAT,
    min_length_section FLOAT
);
```