```sql
-- Создание таблиц
CREATE TABLE IF NOT EXISTS messages (
    id SERIAL PRIMARY KEY,
    code INTEGER,
    text TEXT,
    type TEXT
);

CREATE TABLE IF NOT EXISTS routes (
    id SERIAL PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS route_points (
    id SERIAL PRIMARY KEY,
    route_id INTEGER REFERENCES routes(id),
    point_order INTEGER,
    longitude FLOAT,
    latitude FLOAT,
    velocity FLOAT
);

-- Вставка данных сообщения
INSERT INTO messages (code, text, type)
VALUES (0, 'Success!', 'Info');

-- Вставка данных маршрута
WITH inserted_route AS (
    INSERT INTO routes DEFAULT VALUES RETURNING id
)
INSERT INTO route_points (route_id, point_order, longitude, latitude, velocity)
SELECT 
    (SELECT id FROM inserted_route), 
    point_order, 
    point[1] AS longitude, 
    point[2] AS latitude, 
    velocity
FROM (
    SELECT 
        ordinality-1 AS point_order, 
        point::float[] AS point, 
        velocity
    FROM 
        jsonb_array_elements(
            '[{"points":[[-4.0,4.0],[0.0,6.0],[6.462963514639028,9.231481757319514],[5.930694007454527,15.740936027588475],[9.901142709302915,18.57892083511603],[17.875497307299533,16.661345658303535],[19.6,14.3279022393952],[17.466795882939337,1.8373123117804049],[10.873224262352444,0.6310673528239645],[1.1734927138727524,11.279653496121455],[5.557929385626707,18.797462594380864],[11.588613015479428,17.275961114433244],[12.668535329763689,14.045425660152382],[17.146334311218997,14.217304765126308],[19.542396426568796,16.05488231745873],[19.097762763337588,19.315405987577513],[15.903925765744546,19.598752242537575],[14.626212440413985,16.45501642877119],[10.944071220042202,15.741237807037393],[9.535326056740507,18.68029413751446],[4.908966264110346,19.551559635275133],[0.6860108392557622,13.072271356200403],[4.748083929202195,6.5980119509359945],[7.236798876671743,7.6],[11.855926941008981,5.014086204495097],[16.61385886312854,5.497764915488537],[20.181920313068456,3.621156196052937],[23.677393103648477,7.360165276595765],[22.193440022051508,9.6779637014256],[20.308152124423437,1.3147633686128604],[15.56134054096239,11.335439103989925],[6.208094811968071,15.004954602285677],[3.220003105353716,12.888769194947088],[5.689263619367868,0.7760662790263098],[0.9560193822787468,5.960275255230015],[9.175250573386778,18.26598164995348],[13.483852019485699,16.51492371329432],[17.06869940270583,4.517615743336689],[22.196851493256972,2.0464922725702697],[24.6,2.858355474391723],[21.428200312094013,3.8731941505721634],[16.793094940222826,1.4611442361961786],[8.61837235360693,5.159156124944412],[6.421155719543391,2.731654421408899],[0.8294062697836164,5.831918840882936],[0.4115854434073541,8.812792538958101],[2.2372662383542976,13.230294190555615],[14.31218088759755,14.386283717328318],[17.235524984905958,12.630542638227258],[17.772415303498814,7.840673015724217],[4.940894917447581,0.7836387070536404],[1.3973308327309941,3.6500823474006565],[2.1230711555113735,10.185673682711077],[6.396045745270291,11.122516579851096],[6.192091490540582,11.077799933198676],[2.6062546333359324,3.110676603986539],[3.63281121255051,0.3999999999999999],[6.275547645270292,5.33819511177534],[2.5124080152889467,14.240910062906071],[9.720360280075155,19.28264095005329],[17.79027166372169,17.901930636494157],[19.595378083348628,15.505090018317574],[16.826004963467405,10.000384546170203],[17.43299793314988,6.902335669796244],[11.673420928544605,4.038070157158801],[1.2796710967967417,6.624801648562645],[2.9092499087486554,3.8739613288515904],[13.449467339362963,3.260432747073134],[17.121371504837523,9.241341787483956],[12.114916266888825,14.84722403542065],[6.193787313237818,15.788996810042933],[4.12226339173874,11.61335246169339],[5.221967008198392,1.4649222922756238],[13.673534870089703,0.47803999522485396],[18.77415702301164,14.30594928224107],[16.313089902364652,16.833956527564947],[10.856235959811062,15.249544413395483],[8.042834745247214,17.148443316626818],[1.6398555144584517,15.49852620638795],[0.7786851827679525,11.360882899431164],[7.140909616147591,1.7451711370764844],[12.56931911289636,2.2996734530800014],[16.176026425136335,6.3245530972343085],[17.648883260435312,13.544069945733483],[15.609230804494866,17.266055749144833],[11.907663416102938,19.454125853676015],[8.994820824109276,16.616257059003605],[2.49664696007952,15.861496993385366],[0.7108975932241495,12.857418118059723],[4.268935108779441,5.637457648272949],[9.375435581278554,3.864232710275216],[14.588845504106423,7.677855457917401],[19.09721222766038,18.47587626518831],[27.61964416703702,12.69099186621467],[25.0,6.0]]}]'::jsonb->0->'points'
        ) WITH ORDINALITY AS t(point, ordinality)
    CROSS JOIN 
        unnest(ARRAY[5,5,5,5,5,5,5,5,4.465600162526084,5.665939174140788,6.391182134228096,6.909486740860091,7.1933415492845,7.566766260432774,7.818397120488324,8.09262221175414,8.359820638170024,8.642609652185438,8.955166801266534,9.226769746871716,9.61907692260031,5.263575700310469,5.900497947411505,5.12406874995863,5.56521068850917,5.963748478357823,5.299704026802283,5.726241433443663,5.955586913477559,5.670008932508123,5.594018020375493,5.431294315785461,5.736423304053927,5.7665757314734,5.351571123886927,5.584752902993152,5.972322344072772,5.01577590905339,5.490149729294906,5.701531502856344,5.979047903758968,5.4144770231805,5.162165039749702,5.43501681902934,5.967824511689603,5.218658983542362,5.61698387193702,5.627827426338893,5.911999804679716,5.313655252437773,5.53399687312859,5.91381175462588,5.4617919671532,5.826331121225454,5.84373101676118,5.571805341938006,5.813351088435216,5.280090865556392,5.085539124877382,5.818558120907248,5.50082268505026,5.750867877286687,5.26437440794548,5.527453759431104,5.063493404775535,5.95605998871253,5.22250064252933,5.102338856844916,5.687183049950235,5.313517790431824,5.813147542548215,5.201584734322,5.052238008395335,5.76132063165851,5.98954038442635,5.28355087182362,5.7570691506704,5.03992467227603,5.59093617586493,5.94312877701391,5.9039581801476,5.358679572892385,5.809049743064875,5.423068442919515,4.776753021300955,4.135079105657375,4.47397182120222,4.01912678339576,4.31035729884322,4.98111278163122,4.431580700056436,4.96986089276883,4.94497706771467,4.80333764038437,5.40213219170557]) WITH ORDINALITY AS v(velocity, ordinality)
    WHERE t.ordinality = v.ordinality
) AS points_data;
```

## Альтернативный вариант (если первый не работает)

Если у вас возникают проблемы с первым запросом, можно использовать более простой подход:

```sql
-- Создание таблиц (такое же как выше)
CREATE TABLE IF NOT EXISTS messages (
    id SERIAL PRIMARY KEY,
    code INTEGER,
    text TEXT,
    type TEXT
);

CREATE TABLE IF NOT EXISTS routes (
    id SERIAL PRIMARY KEY
);

CREATE TABLE IF NOT EXISTS route_points (
    id SERIAL PRIMARY KEY,
    route_id INTEGER REFERENCES routes(id),
    point_order INTEGER,
    longitude FLOAT,
    latitude FLOAT,
    velocity FLOAT
);

-- Вставка сообщения
INSERT INTO messages (code, text, type) VALUES (0, 'Success!', 'Info');

-- Вставка маршрута (сначала создаем запись маршрута)
INSERT INTO routes DEFAULT VALUES RETURNING id;

-- Затем вставляем точки (предполагая, что id маршрута = 1)
-- Здесь нужно вставить все точки по очереди, например:
INSERT INTO route_points (route_id, point_order, longitude, latitude, velocity)
VALUES 
(1, 0, -4.0, 4.0, 5),
(1, 1, 0.0, 6.0, 5),
(1, 2, 6.462963514639028, 9.231481757319514, 5),
-- ... и так для всех остальных точек
(1, 99, 25.0, 6.0, 5.40213219170557);
```