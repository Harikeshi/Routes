+ Добавить Изменяемое дерево json.
+ загружаем реквест в дерево, и потом берем деревом изменяем реквест.

- Доделать методы в json.
- Разобраться с разметкой сетки.

- Спираль: Лучи в спирале +  Данные начальные по спирали. + подключить к расчету библиотеки.

+ Подключить динамическую Библиотеку в windows.

- Загрузка библиотеки из /usr/lib

find_library(TASK_LIBRARY
    NAMES Task
    PATHS /usr/lib
    NO_DEFAULT_PATH
)
if(NOT TASK_LIBRARY)
    message(FATAL_ERROR "Library libTask.so not found in /usr/lib")
endif()

target_link_libraries(your_target_name PRIVATE ${TASK_LIBRARY})

target_include_directories(my_app PRIVATE /path/to/headers)

для Windows:

# 1. Ищем библиотеку
find_library(MYLIBRARY_LIB
    NAMES MyLibrary
    PATHS ${PROJECT_SOURCE_DIR}/libs
    NO_DEFAULT_PATH
)

if(NOT MYLIBRARY_LIB)
    message(FATAL_ERROR "MyLibrary.lib not found!")
endif()

# 2. Подключаем заголовки
target_include_directories(MyApp PRIVATE ${PROJECT_SOURCE_DIR}/include)

# 3. Линкуем библиотеку
target_link_libraries(MyApp PRIVATE ${MYLIBRARY_LIB})

# 4. Копируем DLL
add_custom_command(TARGET MyApp POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy
        ${PROJECT_SOURCE_DIR}/libs/MyLibrary.dll
        $<TARGET_FILE_DIR:MyApp>
)

