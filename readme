-deploy
- Положить актуальную библиотеку libTask.so в папку libs.
- Скомпилировать Visualization, должен быть по пути /build/visualization
- Запустить скрипт make-deb.sh

-install
- на целевой машине запускаем sudo -i visualization-1.x.x-AMD64.deb

Настройки для msvc для tasks
-G Ninja -DCMAKE_CXX_FLAGS="/D_USE_MATH_DEFINES" -DCMAKE_TOOLCHAIN_FILE=C:/vcpkg/scripts/buildsystems/vcpkg.cmake -DCMAKE_PREFIX_PATH=C:/Qt/5.15.17-msvc2019_64 -DQt5_DIR=C:/Qt/5.15.17-msvc2019_64/lib/cmake/Qt5 -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_WINDOWS_EXPORT_ALL_SYMBOLS=ON -DCMAKE_CXX_STANDARD:STRING=17

//------------------------------------------------------------------
Требуется фикс в tasks:
inline void validateRegionJson(const nlohmann::json& json)
{
    if (json.find("borders") == json.end())
        throw std::runtime_error("Поле \"borders\" отсутствует.");

    if (!json.at("borders").is_array())
        throw std::runtime_error("Поле \"borders\" не является массивом.");

    if (json.at("borders").size() == 0)
        throw std::runtime_error("Пустое поле \"borders\".");

    //! TODO: Проверка на пустые кольца
    for (const auto& border : json.at("borders"))
    {
        if (border.empty())
        {
            throw std::runtime_error("Одно из колец пустое.");
        }
    }

    if (json.find("entry_point") == json.end())
        throw std::runtime_error("Поле \"entry_point\" отсутствует.");

    if (json.find("exit_point") == json.end())
        throw std::runtime_error("Поле \"exit_point\" отсутствует.");
}

//-------------------------
Для запуска библиотеки с исходниками
- Заменить папки include и src в libTask, взять актуальные в проекте
- Если менялась Core, заменить папку dependencies
